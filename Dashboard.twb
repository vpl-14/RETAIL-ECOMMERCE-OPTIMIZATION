      <aliases enabled='yes' />
      <column caption='Gross Revenue' datatype='real' name='[Calculation_0572628834586624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Quantity] &gt; 0 THEN [Quantity]*[Unit_Price] ELSE 0 END' />
      </column>
      <column caption='Net Revenue' datatype='real' default-format='c&quot;₹&quot;#,##0,.00K;-&quot;₹&quot;#,##0,.00K' name='[Calculation_0572628834775041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Quantity]&gt;0 THEN ([Quantity]*[Unit_Price])*(1-[Discount_Pct]) ELSE 0 END' />
      </column>
      <column caption='Is Return' datatype='boolean' name='[Calculation_0572628835340290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Quantity]&lt;0' />
      </column>
      <column caption='Return Rate' datatype='real' default-format='p0.000%' name='[Calculation_0572628835409923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(COUNTD(IF [Quantity]&lt;0 THEN [Transaction_ID] END)/COUNTD([Transaction_ID]))' />
      </column>
      <column caption='AOV' datatype='real' default-format='c&quot;₹&quot;#,##0.00;-&quot;₹&quot;#,##0.00' name='[Calculation_0572628836065284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0572628834775041])/COUNTD([Transaction_ID])' />
      </column>
